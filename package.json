{
  "name": "fastcraves",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "sass --no-source-map --style=expanded CSS/estilos.scss CSS/index.css && tailwindcss -i CSS/tailwind.input.css -o CSS/tailwind.css --minify && esbuild JS/material.js --bundle --minify --format=iife --target=es2022 --outfile=JS/material.bundle.js",
    "build:sass": "sass --no-source-map --style=expanded CSS/estilos.scss CSS/index.css",
    "build:tailwind": "tailwindcss -i CSS/tailwind.input.css -o CSS/tailwind.css --minify",
    "build:material": "esbuild JS/material.js --bundle --minify --format=iife --target=es2022 --outfile=JS/material.bundle.js",
    "watch:material": "esbuild JS/material.js --bundle --format=iife --target=es2022 --outfile=JS/material.bundle.js --watch",
    "watch:sass": "sass --no-source-map --watch CSS/estilos.scss:CSS/index.css",
    "watch:tailwind": "tailwindcss -i CSS/tailwind.input.css -o CSS/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.28.2",
    "sass": "^1.93.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@material/web": "^2.5.0"
  }
}
